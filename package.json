{
  "name": "mentoring-playground",
  "private": true,
  "packageManager": "pnpm@11.8.0",
  "engines": { "node": ">=24" },
  "scripts": {
    "dev": "pnpm build:api && concurrently -k -n types,api,web \"tsc -p server --watch --preserveWatchOutput\" \"node --watch --inspect=127.0.0.1:9230 --enable-source-maps dist/server/main.js\" \"vite --host 127.0.0.1\"",
    "build:api": "tsc -p server",
    "check": "tsc -p server --noEmit && tsc -p client",
    "build": "pnpm check && pnpm build:api && vite build",
    "test": "pnpm build:api && node --test tests/api.test.cjs",
    "test:browser": "playwright test"
  },
  "dependencies": {
    "@nestjs/common": "^11.2.6",
    "@nestjs/core": "^11.2.6",
    "@nestjs/platform-express": "^11.2.6",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.0",
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^9.2.1",
    "typescript": "~5.9.3",
    "vite": "^8.3.1"
  }
}
