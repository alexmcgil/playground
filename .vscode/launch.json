{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "NestJS: attach",
      "type": "node",
      "request": "attach",
      "address": "127.0.0.1",
      "port": 9230,
      "restart": true,
      "sourceMaps": true,
      "outFiles": ["${workspaceFolder}/dist/server/**/*.js"],
      "skipFiles": ["<node_internals>/**", "**/node_modules/**"]
    },
    {
      "name": "React: Chrome",
      "type": "pwa-chrome",
      "request": "launch",
      "url": "http://127.0.0.1:4310/cards",
      "webRoot": "${workspaceFolder}/client",
      "sourceMaps": true
    }
  ],
  "compounds": [
    {
      "name": "Playground: browser + server",
      "configurations": ["NestJS: attach", "React: Chrome"],
      "stopAll": true
    }
  ]
}
